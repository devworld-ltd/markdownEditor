# Cloudflare Workers Static Assets 헤더 규칙.
# vite 가 public/ 을 dist/ 루트로 복사하므로 배포 산출물에 함께 실린다.
# 개발 서버(vite)에는 적용되지 않는다 — 배포 환경에서만 유효.

/*
  # DOMPurify 다음의 두 번째 방어선. 정화를 우회한 인젝션이 있더라도
  # 외부 스크립트 로드·인라인 실행·데이터 유출 경로를 차단한다.
  #
  # style-src 에 'unsafe-inline' 이 필요한 이유: 마크다운 본문의 인라인 style
  # 속성(DOMPurify 가 허용)이 렌더되려면 필요하다. 인라인 스크립트와 달리
  # 실행 권한이 없어 위험도가 낮다.
  # img-src 에 https: 가 필요한 이유: 문서의 ![](https://…) 외부 이미지.
  # img-src 에 data: 가 필요한 이유: 인라인 SVG 파비콘.
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()

# 콘텐츠 해시가 붙은 자산은 영구 캐시 가능하다.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 진입 문서는 항상 최신을 받아야 새 배포가 즉시 반영된다.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# 서비스 워커는 절대 캐시하지 않는다 — 캐시되면 업데이트가 영원히 막힌다.
/sw.js
  Cache-Control: no-cache
