{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markdown-editor",
  "compatibility_date": "2026-08-12",
  "observability": { "enabled": true },

  // F-60 이전에는 main 이 없는 정적 자산 전용 Worker 였다. 공유 링크를 위해
  // 진입점이 생겼지만, 편집·저장·프리뷰는 여전히 브라우저 안에서 끝난다 —
  // Worker 는 /api/share 와 /s/<id> 만 처리하고 나머지는 자산으로 넘긴다.
  "main": "worker/index.ts",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // ⚠️ 정적 자산 계층은 **Worker 보다 먼저** 요청을 가로챈다. not_found_handling
    // 이 SPA 라서 매칭되는 자산이 없는 GET 은 곧바로 index.html 로 응답해 버리고,
    // Worker 코드는 아예 실행되지 않는다. 실제로 dev 배포 후 GET /api/share/<id>
    // 가 마크다운 대신 앱 HTML 을 돌려주는 것으로 드러났다(POST 는 자산 계층이
    // 다루지 않아 통과했기 때문에 절반만 동작했다).
    //
    // 이 두 경로만 Worker 를 먼저 태운다.
    "run_worker_first": ["/api/*", "/s/*", "/i/*"]
  },

  "env": {
    "dev": {
      "name": "markdown-editor-dev",
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/s/*", "/i/*"]
      },
      "r2_buckets": [
        { "binding": "SHARES", "bucket_name": "md-editor-shares-dev" }
      ],

      // F-67: dev 도 커스텀 도메인을 쓴다. prod 와 설정이 비대칭이면
      // "dev 에서만 재현되지 않는" 문제가 생긴다 — 특히 보안 컨텍스트·쿠키·
      // CSP 처럼 호스트에 딸린 동작이 그렇다.
      //
      // 커스텀 도메인은 첫 배포 때 생성되며 인증서 프로비저닝 동안 500 이 날 수
      // 있다(헬스체크의 재시도가 이를 흡수한다).
      "routes": [
        { "pattern": "md-editor-dev.devworld.co.kr", "custom_domain": true }
      ],

      // 커스텀 도메인을 추가하면 *.workers.dev 주소가 **자동으로 꺼진다**(실측:
      // 404). dev 에서는 인증서 프로비저닝 중이거나 DNS 문제가 있을 때 기댈
      // 곳이 필요하므로 명시적으로 살려 둔다.
      "workers_dev": true,

      "vars": { "APP_ENV": "dev" }
    },
    "prod": {
      "name": "markdown-editor-prod",
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/s/*", "/i/*"]
      },
      "r2_buckets": [
        { "binding": "SHARES", "bucket_name": "md-editor-shares" }
      ],
      "vars": { "APP_ENV": "prod" },

      // 커스텀 도메인. 배포 시 Cloudflare 가 DNS 레코드(프록시 CNAME)와
      // 인증서를 자동 생성한다. devworld.co.kr 존이 같은 계정에 있어야 한다.
      "routes": [
        { "pattern": "md-editor.devworld.co.kr", "custom_domain": true }
      ]
    }
  }
}
