{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markdown-editor",
  "compatibility_date": "2026-08-12",
  "observability": { "enabled": true },

  // 서버 로직이 없는 정적 자산 전용 Worker. dist/ 를 그대로 서빙한다.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  "env": {
    "dev": {
      "name": "markdown-editor-dev",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      },
      "vars": { "APP_ENV": "dev" }
    },
    "prod": {
      "name": "markdown-editor-prod",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      },
      "vars": { "APP_ENV": "prod" },

      // 커스텀 도메인. 배포 시 Cloudflare 가 DNS 레코드(프록시 CNAME)와
      // 인증서를 자동 생성한다. devworld.co.kr 존이 같은 계정에 있어야 한다.
      "routes": [
        { "pattern": "md-editor.devworld.co.kr", "custom_domain": true }
      ]
    }
  }
}
