{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // ES2022.Intl 은 `Intl.Segmenter` 타입 때문이다 (F-30 표시 폭 계산).
    // target 은 ES2020 그대로 — Segmenter 는 런타임 API 라 문법 수준과 무관하고,
    // 없는 브라우저에서는 tableFormat.ts 가 코드 포인트 단위로 폴백한다.
    "lib": ["ES2020", "ES2022.Intl", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // 번들링은 vite 가 전담한다. tsc 는 타입 검사만 수행하므로 emit 관련 옵션
    // (outDir/declaration/sourceMap)을 두지 않는다. 예전 설정은 tsc 가 dist/ 에
    // .js/.d.ts 를 쏟아낸 뒤 vite build 가 덮어쓰는 구조라, tsc 가 실패하면
    // 중간 산출물이 dist/ 에 그대로 남았다.
    "noEmit": true,

    // import.meta.env (PROD 등) 타입
    "types": ["vite/client"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "tests"]
}
